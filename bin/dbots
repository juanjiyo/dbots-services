#!/usr/bin/env php
<?php

declare(strict_types=1);

use Dbots\Kernel;
use Symfony\Bundle\FrameworkBundle\Console\Application;
use Symfony\Component\Console\Input\ArrayInput;
use Symfony\Component\Console\Output\ConsoleOutput;
use Symfony\Component\Dotenv\Dotenv;

require_once dirname(__DIR__) . '/vendor/autoload.php';

if (is_file(dirname(__DIR__) . '/.env')) {
    (new Dotenv())->bootEnv(dirname(__DIR__) . '/.env');
}

// Without this PHP stays in UTC and every timestamp we print is wrong by the
// offset of the network's own timezone.
date_default_timezone_set($_SERVER['DBOTS_TIMEZONE'] ?? 'UTC');

$kernel = new Kernel($_SERVER['APP_ENV'] ?? 'prod', false);
$application = new Application($kernel);
$application->setAutoExit(false);

return $application->run(
    new ArrayInput(['command' => 'dbots:run', 'seconds' => $argv[1] ?? '0']),
    new ConsoleOutput(),
);
