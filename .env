# Runtime
APP_ENV=prod
APP_DEBUG=0

# IRC link
DBOTS_LINK_NAME=bots.sitiochat.es
DBOTS_LINK_SID=003
DBOTS_LINK_HOST=127.0.0.1
DBOTS_LINK_PORT=6900
DBOTS_LINK_PASSWORD=
DBOTS_LINK_TLS_VERIFY=0
DBOTS_LINK_DESCRIPTION="dbots services"

# Storage and behaviour
DBOTS_DATABASE=%kernel.project_dir%/var/dbots.sqlite
DBOTS_ROOT_PASSWORD=
DBOTS_RECONNECT_DELAY=5

# Clock used by the debug channel and any timestamp we print
DBOTS_TIMEZONE=Europe/Madrid
